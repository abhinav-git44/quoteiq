# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://quoteiq:quoteiq@localhost:5432/quoteiq
# AI provider: set ONE key. LLM_PROVIDER=auto prefers Claude when both are set.
LLM_PROVIDER=auto
# Free: Google AI Studio key (aistudio.google.com). Free tier is rate-limited (a few requests/minute).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Paid: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_URL=https://api.anthropic.com
BASE_CURRENCY=INR
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=25
# Heuristic confidence bands (0-100), not calibrated probabilities
CONFIDENCE_HIGH=90
CONFIDENCE_REVIEW_BELOW=70
# Normalization policy
COMPARE_EX_TAX=true
APPLY_EARLY_PAYMENT_DISCOUNTS=false
FREIGHT_AT_ACTUALS_ASSUMED_PCT=4.0
DERIVED_WEIGHT_REQUIRES_REVIEW=true
JWT_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_API_URL=http://localhost:8000
